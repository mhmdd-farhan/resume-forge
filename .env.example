# ------------------------------------------------------------------
# n8n Webhook (Resume Generator)
# ------------------------------------------------------------------
N8N_WEBHOOK_URL=https://n8n.gloapp.my.id/webhook/resume-generator
# n8n Webhook Basic Auth (format: username:password)
N8N_BASIC_AUTH=your-n8n-username:your-n8n-password

# ============================================================
# Database & Admin
# ============================================================
DATABASE_URL=postgresql://user:password@host:5432/database

# Admin dashboard HTTP basic auth (leave unset to keep /admin closed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Google OAuth (required for Google sign-in)
# Get from Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Redirect URI: https://your-app-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# Public site URL. NEXT_APP_URL is preferred (server env);
# NEXT_PUBLIC_APP_URL is also read as a fallback and is used by the client
# bundle for landing-page JSON-LD/SEO URLs.
NEXT_APP_URL=https://your-app-domain.com
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# ============================================================
# Midtrans payment gateway (checkout via Snap)
# ============================================================
# "sandbox" or "production" (default: sandbox)
MIDTRANS_ENV=sandbox
# Get these from Midtrans dashboard: Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
# Optional price overrides (IDR). Defaults: starter 15000, premium 49000, annual 399000.
# The server charges using MIDTRANS_*_PRICE (reads NEXT_PUBLIC_* as fallback);
# the landing page displays NEXT_PUBLIC_MIDTRANS_*_PRICE. Keep them in sync.
MIDTRANS_STARTER_PRICE=15000
MIDTRANS_PREMIUM_PRICE=49000
MIDTRANS_ANNUAL_PRICE=399000
NEXT_PUBLIC_MIDTRANS_STARTER_PRICE=15000
NEXT_PUBLIC_MIDTRANS_PREMIUM_PRICE=49000
NEXT_PUBLIC_MIDTRANS_ANNUAL_PRICE=399000