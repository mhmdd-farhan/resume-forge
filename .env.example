# n8n Webhook (Resume Generator)
N8N_WEBHOOK_URL=https://n8n.gloapp.my.id/webhook/resume-generator
# n8n Webhook Basic Auth (format: username:password)
N8N_BASIC_AUTH=your-n8n-username:your-n8n-password

# ============================================================
# Database & Auth
# ============================================================
DATABASE_URL=postgresql://user:password@host:5432/database
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=https://your-app-domain.com

# ============================================================
# Midtrans payment gateway (checkout via Snap)
# ============================================================
# "sandbox" or "production" (default: sandbox)
MIDTRANS_ENV=sandbox
# Get these from Midtrans dashboard: Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
# Optional price overrides (IDR). Defaults: starter 15000, premium 49000, annual 399000
MIDTRANS_STARTER_PRICE=15000
MIDTRANS_PREMIUM_PRICE=49000
MIDTRANS_ANNUAL_PRICE=399000

NEXT_PUBLIC_APP_URL=http://localhost:3000
