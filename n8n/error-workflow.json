        {
            "parameters": {
                "jsCode": "const t = $json ?? {};\nreturn [{\n  json: {\n    text:\n      \"ResumeForge n8n workflow failed!\\n\\n\" +\n      \"Workflow: \" + (t.workflow?.name ?? \"unknown\") + \"\\n\" +\n      \"Node: \" + (t.trigger?.node ?? \"unknown\") + \" (\" + (t.trigger?.type ?? \"\") + \")\\n\" +\n      \"Error: \" + (t.error?.message ?? t.error ?? \"unknown\") + \"\\n\" +\n      \"Last Node Output: \" + JSON.stringify(t.lastNodeExecutedData ?? t.execution ?? {}).slice(0, 1500),\n  },\n}];"
            },
            "id": "93e04ba4-49a4-463f-a275-dfce53269c8d",
            "name": "Format Error",
